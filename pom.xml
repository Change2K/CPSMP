<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.deinserver</groupId>
    <artifactId>cpsmp</artifactId>
    <version>3.1.0</version>
    <packaging>jar</packaging>

    <name>CPSMP</name>
    <description>Premium SMP foundation plugin (V3.0).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!--
            Paper API baseline. CPSMP is developed against this version and
            best-effort tested on newer Paper releases. To target a newer
            Paper, bump this property only and re-test:
                <paper.api.version>1.21.X-R0.1-SNAPSHOT</paper.api.version>
            Future Minecraft updates may also raise the required Java
            version - bump <java.version> in lockstep when that happens.
            See COMPATIBILITY.md.
        -->
        <paper.api.version>1.21.4-R0.1-SNAPSHOT</paper.api.version>
        <!--
            VaultAPI is the standard economy abstraction in the Bukkit
            ecosystem. CPSMP depends on it at compile time only; at runtime
            we detect whether Vault is installed AND whether a Vault
            economy provider is registered. See DEPENDENCIES.md.
        -->
        <vault.api.version>1.7.1</vault.api.version>
        <java.version>21</java.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- VaultAPI is published through JitPack. -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
            VaultAPI is `provided` so the classes are available at compile
            time but never shipped inside our jar. At runtime we only
            reference Vault classes after confirming the Vault plugin is
            loaded; otherwise NoEconomyBridge is used and the Vault
            classes are never resolved. CPSMP does not require Vault to
            run; it is only required for economy-dependent features (e.g.
            the planned Auction House).
        -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>${vault.api.version}</version>
            <scope>provided</scope>
            <exclusions>
                <!-- VaultAPI ships against an old Bukkit; we already use paper-api. -->
                <exclusion>
                    <groupId>org.bukkit</groupId>
                    <artifactId>bukkit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <showDeprecation>true</showDeprecation>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
